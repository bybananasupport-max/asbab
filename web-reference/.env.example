# Salin ke Netlify: Site configuration > Environment variables.
# JANGAN commit nilai sebenar ke GitHub.

# Password masuk Asbab. Kalau tak diset, password lalai ialah CHANGE_ME.
ASBAB_PASSWORD=

# Otak kedua (Claude)
ANTHROPIC_API_KEY=
ASBAB_MODEL_LIGHT=claude-haiku-5-5
ASBAB_MODEL_HEAVY=claude-sonnet-5-5

# Project kod (pilihan): token GitHub dengan akses Contents read & write
GITHUB_TOKEN=

# Notifikasi telefon (pilihan). Jana dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emel-kau@contoh.com
